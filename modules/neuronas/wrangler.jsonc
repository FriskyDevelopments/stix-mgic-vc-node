{
  // Knowledge/notes module for any white-label tenant. No account id and no secrets.
  // Do not deploy this draft and do not attach a route or DNS record.
  "name": "wl-neuronas",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "vars": {
    "LOG_LEVEL": "info"
    // TENANT_CONFIG_JSON: public tenant document, set per environment.
    // It is configuration, not a secret. Do not put tokens in it.
  }
  // Required before notes can outlive the isolate. Leave this commented
  // until the KV adapter exists. Replace the placeholder outside git.
  // "kv_namespaces": [
  //   { "binding": "NEURONAS_KV", "id": "PLACEHOLDER_KV_NAMESPACE_ID" }
  // ]
}
