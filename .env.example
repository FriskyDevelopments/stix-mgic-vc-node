# Client (Vite)
# Production builds default to control-plane mode (VITE_DEMO_MODE unset => live API).
# Local `npm run dev` defaults to demo unless set false.
VITE_DEMO_MODE=false
VITE_API_BASE_URL=
VITE_OPERATOR_TIER=premium
VITE_AUTH_REQUIRED=false
VITE_DISCORD_CLIENT_ID=
VITE_SPOTIFY_CLIENT_ID=

# Server (control plane) — never expose secrets to Vite
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
OPERATOR_TOKEN_SECRET=replace-with-32-plus-random-chars
OPERATOR_TOKEN_TTL_SECONDS=3600
SESSION_ISSUER=stix-magic-vc-node
AUTH_REQUIRED=false
MEDIA_PLANE_ENABLED=false
LOG_LEVEL=info

# WebRTC media plane
# STUN gets most peers connected. TURN is what connects the rest — symmetric NAT and
# restrictive corporate firewalls — and it RELAYS the media, so it costs bandwidth and is
# optional. /v1/media/status reports `webrtc: degraded` while it is absent, and says so.
# TURN credentials are secrets: provision through op:// -> env, never commit a value.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Discord OAuth (server-side exchange)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/auth/discord/callback

# Telegram Login Widget verification
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Telegram VC adapter (MTProto user session) — SECRETS, never commit values.
# These come from 1Password / Frisky Secret Center via op:// references.
# The session string is equivalent to the account password. If it leaks, the account
# is compromised.
# To generate a session string: run `npx teleproto` interactively once, log in with
# the dedicated account, and copy the session string it prints.
TELEGRAM_VC_API_ID=
TELEGRAM_VC_API_HASH=
TELEGRAM_VC_SESSION_STRING=
# Optional: default chat ID to join (saves specifying it on each /join call)
TELEGRAM_VC_DEFAULT_CHAT_ID=
# Max seconds an ffmpeg transcode process can run (default: 300 = 5 minutes)
TELEGRAM_VC_FFMPEG_TIMEOUT_SECONDS=300
