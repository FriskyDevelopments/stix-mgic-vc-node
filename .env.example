# Client (Vite)
# Production builds default to control-plane mode (VITE_DEMO_MODE unset => live API).
# Local `npm run dev` defaults to demo unless set false.
VITE_DEMO_MODE=false
VITE_API_BASE_URL=
VITE_OPERATOR_TIER=premium
VITE_AUTH_REQUIRED=false
VITE_DISCORD_CLIENT_ID=
VITE_SPOTIFY_CLIENT_ID=
# Public Telegram bot username for Login Widget (no @)
VITE_TELEGRAM_BOT_USERNAME=
# PostHog (optional — leave blank to disable analytics)
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server (control plane) — never expose secrets to Vite
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
OPERATOR_TOKEN_SECRET=replace-with-32-plus-random-chars
OPERATOR_TOKEN_TTL_SECONDS=3600
SESSION_ISSUER=stix-magic-vc-node
AUTH_REQUIRED=false
MEDIA_PLANE_ENABLED=false
LOG_LEVEL=info

# Discord OAuth (server-side exchange + FriskyDev link)
# WebRTC media plane
# STUN gets most peers connected. TURN is what connects the rest — symmetric NAT and
# restrictive corporate firewalls — and it RELAYS the media, so it costs bandwidth and is
# optional. /v1/media/status reports `webrtc: degraded` while it is absent, and says so.
# TURN credentials are secrets: provision through op:// -> env, never commit a value.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/auth/discord/callback

# Telegram Login Widget verification + FriskyDev link
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Supabase FriskyDev identity (Apple / Google / Microsoft). Public by design.
# The service-role key must never appear here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# FriskyDev ID (Authentik OIDC). Optional; health.friskydevIdConfigured when all four are set.
AUTHENTIK_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5000/v1/auth/oidc/callback
IDENTITY_PROVIDER=supabase

