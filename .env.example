# Demo mode (default). Set to "false" only when VITE_API_BASE_URL points at a real session API.
VITE_DEMO_MODE=true

# Optional live session-control API base URL (enables production session start/stop).
# Expected endpoints:
#   POST /v1/sessions/start
#   POST /v1/sessions/stop
#   POST /v1/sessions/extend
# VITE_API_BASE_URL=https://api.example.com

# Operator tier for demo/UI gating: free | premium
VITE_OPERATOR_TIER=premium

# Optional — Discord OAuth client ID (public). Without this, Discord auth uses a local mock popup.
# Discord Developer Portal → OAuth2 → Redirects:
#   http://localhost:5000/auth/discord/callback
#   https://YOUR_DOMAIN/auth/discord/callback
VITE_DISCORD_CLIENT_ID=

# Optional — Spotify client ID (public, PKCE). Without this, Spotify login is disabled with a clear error.
# Spotify Dashboard → Redirect URIs:
#   http://localhost:5000/spotify-callback
#   https://YOUR_DOMAIN/spotify-callback
VITE_SPOTIFY_CLIENT_ID=
