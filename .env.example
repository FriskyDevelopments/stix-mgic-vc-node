# Optional — Discord OAuth client ID (public). Without this, Discord auth uses a local mock popup.
# Discord Developer Portal → OAuth2 → Redirects:
#   http://localhost:5000/auth/discord/callback
VITE_DISCORD_CLIENT_ID=

# Optional — Spotify client ID (public, PKCE). Without this, Spotify login is disabled with a clear error.
# Spotify Dashboard → Redirect URIs:
#   http://localhost:5000/spotify-callback
VITE_SPOTIFY_CLIENT_ID=
